# Copia este archivo a .env y llénalo.

# Llave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Contraseña larga que usan el celular y el panel. Genera una con: openssl rand -hex 24
APP_TOKEN=

NOMBRE_USUARIO=Don Pepe
NOMBRE_ASISTENTE=Chema
CIUDAD=Ciudad de México
LATITUD=19.4326
LONGITUD=-99.1332
ZONA_HORARIA=America/Mexico_City

# Avisos a la familia por Telegram (recomendado, gratis). Ver README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Avisos por WhatsApp con CallMeBot (opcional): telefono:apikey separados por coma
CALLMEBOT_WHATSAPP=

# Opcionales
# MODELO=claude-opus-5-5
# ESFUERZO=low
# MINUTOS_ESCALAR_MEDICINA=30
# MINUTOS_CELULAR_DESCONECTADO=60
# MINUTOS_REINICIAR_PLATICA=10
# RUTA_DB=/datos/asistente.db
