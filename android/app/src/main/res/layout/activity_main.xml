<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:gravity="center"
            android:textSize="28sp"
            android:text="Apagado" />

        <Button
            android:id="@+id/hablar"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            android:textSize="34sp"
            android:text="🎤  HABLAR" />

        <Button
            android:id="@+id/ayuda"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#C62828"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:text="AYUDA" />

        <Button
            android:id="@+id/mostrar_config"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="Configuración (para la familia)" />

        <LinearLayout
            android:id="@+id/config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dirección del servidor" />
            <EditText
                android:id="@+id/servidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://mi-servidor.com"
                android:inputType="textUri" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Contraseña del servidor (APP_TOKEN)" />
            <EditText
                android:id="@+id/token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Palabra para despertarlo" />
            <EditText
                android:id="@+id/palabra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="oye asistente"
                android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Teléfono para SMS de emergencia (si no hay internet)" />
            <EditText
                android:id="@+id/telefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Velocidad de la voz" />
            <SeekBar
                android:id="@+id/velocidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10" />

            <Button
                android:id="@+id/guardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Guardar y activar" />

            <Button
                android:id="@+id/permisos_extra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permisos de batería y llamadas" />

            <Button
                android:id="@+id/detener"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apagar el asistente" />

            <TextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
